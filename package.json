{
  "name": "tend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "pretest": "node scripts/node-check.mjs --tests",
    "test": "node --no-warnings --test src/lib/*.test.ts src/server/*.test.ts src/sanctuary/*.test.ts src/i18n/*.test.ts src/ui/*.test.ts examples/claude-agent/*.test.mjs examples/claude-quickstart/*.test.mjs scripts/verify/*.test.mjs examples/adapters/*.test.mjs examples/hooks/*.test.mjs",
    "test:postgres": "sh scripts/test-postgres.sh",
    "e2e:authz": "node scripts/authz-e2e.mjs",
    "e2e:gateway": "node scripts/gateway-e2e.mjs",
    "e2e:connect": "node scripts/connect-e2e.mjs",
    "e2e:accounts": "node scripts/accounts-e2e.mjs",
    "e2e:open-beta": "node scripts/open-beta-e2e.mjs",
    "e2e:onboarding": "node scripts/onboarding-notify-e2e.mjs",
    "e2e:claude-hooks": "node --no-warnings scripts/claude-hooks-e2e.mjs",
    "qa:inventory": "node scripts/qa-inventory.mjs",
    "qa:agent": "node scripts/qa-agent.mjs",
    "onboarding:test": "node scripts/onboarding-test.mjs",
    "e2e:claude-notes": "node --env-file-if-exists=.env.local scripts/claude-notes-e2e.mjs",
    "e2e:claude-gateway": "node --env-file-if-exists=.env.local scripts/claude-gateway-e2e.mjs",
    "demo:claude-notes": "node --env-file-if-exists=.env.local scripts/claude-notes-demo.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:check": "node --no-warnings --env-file-if-exists=.env.local scripts/db-check.ts",
    "agents:setup": "node scripts/real-agent-setup.mjs",
    "agents:openai": "node examples/real-agents/openai-agent.mjs",
    "agents:anthropic": "node examples/real-agents/anthropic-agent.mjs",
    "e2e:real-agents": "node scripts/real-agents-e2e.mjs",
    "e2e:real-claude": "node scripts/real-claude-e2e.mjs",
    "verify:integrations": "node scripts/verify-integrations.mjs",
    "reliability": "node scripts/reliability.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "verify:setup": "node scripts/verify/setup.mjs",
    "demo": "node scripts/demo.mjs",
    "demo:cross": "node scripts/demo-cross.mjs",
    "demo:universal": "node scripts/demo-universal.mjs",
    "tend": "node scripts/tend-cli.mjs",
    "agents:try": "node scripts/agents-try.mjs",
    "agents:confined": "node scripts/agents-confined.mjs",
    "agents:doctor": "node scripts/agents-doctor.mjs",
    "e2e:browser": "node scripts/browser-e2e.mjs",
    "beta:provision": "node scripts/beta-config.mjs provision",
    "beta:check": "node scripts/beta-config.mjs check",
    "beta:live": "node scripts/beta-live-check.mjs",
    "beta:rehearse": "node scripts/beta-rehearsal.mjs",
    "beta:local": "node scripts/beta-local.mjs",
    "beta:local:rehearse": "node scripts/beta-local-rehearsal.mjs",
    "tester:init": "node scripts/tester-init.mjs",
    "tester:agent": "node scripts/tester-agent.mjs",
    "tester:export": "node scripts/tester-export.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "framer-motion": "^14.6.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@openai/agents": "^0.21.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=20.12.0"
