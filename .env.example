# Tend configuration. Copy to .env.local for development; never commit real values.
# In production, set these in Vercel → Project → Settings → Environment Variables.

# Postgres connection string. Required on Vercel.
# Adding Neon from the Vercel Marketplace (Storage tab) creates the database and sets this for you.
# Use the pooled connection string. Leave empty locally to use an embedded database in TEND_DATA_DIR.
DATABASE_URL=

# Operator sign-in token: at least 24 random characters; shorter values are ignored.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Without it, nobody can sign in and the instance is read-only. Changing it signs every operator out.
TEND_ADMIN_TOKEN=

# 1 = visitors may browse read-only without signing in (the public demonstration).
# Default: 1 when TEND_ADMIN_TOKEN is unset, otherwise 0.
TEND_PUBLIC=1

# 0 = no simulated agents are seeded or advanced. Default: 1. Simulated agents are always labelled.
TEND_DEMO=1

# Number of reverse proxies in front of Tend (usually 1). Rate limits trust the address they report; a client-sent
# X-Forwarded-For is never trusted. Automatic on Vercel. Unset, forwarded headers are ignored and callers share one limit.
TEND_TRUSTED_PROXY=

# Local development only: where the embedded database lives when DATABASE_URL is empty.
TEND_DATA_DIR=./.data

# ---- Real-agent examples (OpenAI / Anthropic through the gateway): docs/manual-testing.md ----
# Absolute path of the disposable sandbox folder the test file tools use. Unset = those tools answer "not set up".
# `npm run agents:setup` creates the folder and prints this line with your path.
TEND_GATEWAY_SANDBOX_DIR=
# The two lines below are for the AGENT process, not the server. Put them in .env.agent (git-ignored), never next to TEND_ADMIN_TOKEN:
# an agent refuses to start if its environment holds server secrets, and agents never open .env.local.
#   OPENAI_API_KEY=
#   ANTHROPIC_API_KEY=
# `npm run agents:setup` writes TEND_OPENAI_AGENT_KEY / TEND_ANTHROPIC_AGENT_KEY into .env.agent for you.
# For a hosted instance behind Vercel Deployment Protection, put its "protection bypass for automation" secret in .env.agent (agent side only):
#   TEND_PROTECTION_BYPASS=
# For an instance behind Cloudflare Access (served from a local machine through a Cloudflare Tunnel), an Access service token (agent side only):
#   TEND_CF_ACCESS_CLIENT_ID=
#   TEND_CF_ACCESS_CLIENT_SECRET=
# and set TEND_URL to the instance's https address.
