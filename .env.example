# Tend configuration. Copy to .env.local for development; never commit real values.
# In production, set these in Vercel → Project → Settings → Environment Variables.

# Postgres connection string. Required on Vercel.
# Adding Neon from the Vercel Marketplace (Storage tab) creates the database and sets this for you.
# Use the pooled connection string. Leave empty locally to use an embedded database in TEND_DATA_DIR.
DATABASE_URL=

# Operator sign-in token: at least 24 random characters; shorter values are ignored.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Without it, nobody can sign in and the instance is read-only. Changing it signs every operator out.
TEND_ADMIN_TOKEN=

# 0 = the admin is turned off (nothing is deleted): no admin-token sign-in, /operator, /admin and the admin API answer 404, the dashboard is
# never public, and a confirmed e-mail address is enough to use an account (no approval step). Remove the line to bring the admin back.
# TEND_ADMIN=0

# 0 = no confirmation e-mail at sign-up: a new account can sign in at once (its address stays recorded as not confirmed). Anyone can then
# create an account with an address they do not own. Password reset still works by mail. Remove the line to require confirmation again.
# TEND_EMAIL_VERIFICATION=0

# Browser notifications (Web Push). Optional: without all three, notifications are listed in TEND only and Settings says browser ones are not
# set up. `node scripts/vapid-keys.mjs` prints a pair. Keep the private key secret; a new pair means everyone turns notifications on again.
# TEND_VAPID_PUBLIC_KEY=
# TEND_VAPID_PRIVATE_KEY=
# TEND_VAPID_SUBJECT=mailto:you@example.com

# 1 = visitors may browse read-only without signing in (the public demonstration).
# Default: 1 when TEND_ADMIN_TOKEN is unset in development, otherwise 0. A production build is never public unless you set TEND_PUBLIC=1.
TEND_PUBLIC=1

# 0 = no simulated agents are seeded or advanced. Default: 1. Simulated agents are always labelled.
TEND_DEMO=1

# A shared, read-only demo account: "<e-mail> <scrypt hash of its password>" (the hash from hashPassword() in
# src/server/accounts.ts, never the password itself). The first sign-in with that address creates the account with a
# workspace of labelled sample agents and no API keys; every change it asks for is refused. A new hash changes the
# password and ends its sessions; removing the variable turns the demo off. Unset: no demo account.
# TEND_DEMO_ACCOUNT=

# Number of reverse proxies in front of Tend (usually 1). Rate limits trust the address they report; a client-sent
# X-Forwarded-For is never trusted. Automatic on Vercel. Unset, forwarded headers are ignored and callers share one limit.
TEND_TRUSTED_PROXY=

# Local development only: where the embedded database lives when DATABASE_URL is empty.
TEND_DATA_DIR=./.data

# ---- Real-agent examples (OpenAI / Anthropic through the gateway): docs/manual-testing.md ----
# Absolute path of the disposable sandbox folder the test file tools use. Unset = those tools answer "not set up".
# `npm run agents:setup` creates the folder and prints this line with your path.
TEND_GATEWAY_SANDBOX_DIR=
# The two lines below are for the AGENT process, not the server. Put them in .env.agent (git-ignored), never next to TEND_ADMIN_TOKEN:
# an agent refuses to start if its environment holds server secrets, and agents never open .env.local.
#   OPENAI_API_KEY=
#   ANTHROPIC_API_KEY=
# `npm run agents:setup` writes TEND_OPENAI_AGENT_KEY / TEND_ANTHROPIC_AGENT_KEY into .env.agent for you.
# For a hosted instance behind Vercel Deployment Protection, put its "protection bypass for automation" secret in .env.agent (agent side only):
#   TEND_PROTECTION_BYPASS=
# For an instance behind Cloudflare Access (served from a local machine through a Cloudflare Tunnel), an Access service token (agent side only):
#   TEND_CF_ACCESS_CLIENT_ID=
#   TEND_CF_ACCESS_CLIENT_SECRET=
# and set TEND_URL to the instance's https address.

# Optional: every agent API key issued from now on expires after at most this many days (1-3650; a caller may ask for fewer via
# "keyExpiresInDays" when registering or rotating a key, never more). Unset: keys do not expire. Keys already issued keep working until
# they are rotated or revoked.
# TEND_KEY_MAX_AGE_DAYS=90

# Authenticated agent requests per minute for ALL agents of one workspace together (100-100000, default 3000). Every write takes one
# database-wide lock, so this keeps one workspace from starving the others. TEND_AGENT_RPM is the per-agent limit (default 120).
# TEND_WORKSPACE_RPM=3000

# Database-enforced tenant isolation (row-level security, docs/database-roles.md). On by default for a production server on PostgreSQL;
# the server refuses to start if it cannot be guaranteed. Turning it off leaves only the application's own workspace checks.
# TEND_DB_ISOLATION=on
# The NOLOGIN role each transaction switches to when DATABASE_URL is the schema owner (created at start-up; needs CREATEROLE once).
# TEND_DB_RUNTIME_ROLE=tend_runtime

# Signs the tenant context of every database transaction, so SQL injected into the application's session cannot pick another tenant
# (docs/database-roles.md). At least 32 random characters; effective with a restricted login (DATABASE_MIGRATE_URL). Rotation: set the new
# key and redeploy; old keys stay valid until removed from tend_context_keys by the schema owner.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# TEND_CONTEXT_KEY=

# Production database requirements (TEND_DB_STRICT, on by default in production): DATABASE_URL must be a RESTRICTED login that cannot become
# the schema owner or any privileged role, DATABASE_MIGRATE_URL the owner (used only at start-up to migrate and to grant the restricted login
# its privileges), and TEND_CONTEXT_KEY must be set. Otherwise the server does not start. Set up once (docs/database-roles.md):
#   CREATE ROLE tend_app LOGIN PASSWORD '…' NOSUPERUSER NOCREATEDB NOCREATEROLE NOBYPASSRLS;  GRANT CONNECT ON DATABASE <db> TO tend_app;
# DATABASE_MIGRATE_URL=
# A deployment that still uses one owner URL can start only with this explicit exception (logged at every start; RLS is then bypassable by
# SQL injection):
# TEND_DB_ALLOW_OWNER_LOGIN=1

# Security alerts (docs/monitoring.md): each alert is POSTed here as JSON, no customer data. HTTPS on a production server.
# TEND_ALERT_WEBHOOK_URL=
# Encrypts accounts' two-step sign-in secrets (docs/authentication.md). Required in production to turn two-step sign-in on. 32+ random characters.
# TEND_MFA_KEY=
