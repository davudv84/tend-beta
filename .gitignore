# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build output
/.next/
/out/
/build
/coverage

# Environment: real values never leave your machine. Only the template is committed.
.env*
!.env.example

# Vercel CLI link
.vercel

# Local data: the embedded development database, never committed
/.data

# Secrets that should never be committed by accident
*.pem
*.key
*.p12

# Local render previews (the ones worth sharing live in docs/images)
/previews

# Local tool state
.claude-flow/
.claude/*
!.claude/skills/

# Logs and OS files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.DS_Store

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Disposable folder for the real-agent examples (npm run agents:setup)
.agent-sandbox/

# Per-tester beta settings and secrets (scripts/beta-config.mjs)
beta-envs/
beta-data/

# Integration verification: framework packages and Python environments (npm run verify:setup)
/.verify/
/scripts/verify/frameworks/node_modules/
__pycache__/
